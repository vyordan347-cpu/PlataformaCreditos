@model List<PlataformaCreditos.Models.SolicitudCredito>

<h1>Panel de Analista</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Monto</th>
            <th>Ingresos</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var s in Model)
    {
        <tr>
            <td>@s.Id</td>
            <td>@s.MontoSolicitado</td>
            <td>@s.Cliente?.IngresosMensuales</td>
            <td>
                <a asp-action="Aprobar" asp-route-id="@s.Id" class="btn btn-success btn-sm">Aprobar</a>
                <a asp-action="Rechazar" asp-route-id="@s.Id" class="btn btn-danger btn-sm">Rechazar</a>
            </td>
        </tr>
    }
    </tbody>
</table>