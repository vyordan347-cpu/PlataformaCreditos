@model PlataformaCreditos.ViewModels.CrearSolicitudViewModel

@{
    ViewData["Title"] = "Registrar solicitud";
}

<h1>Registrar solicitud</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

<form asp-action="Crear" method="post">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="MontoSolicitado" class="form-label">Monto solicitado</label>
        <input asp-for="MontoSolicitado" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="MontoSolicitado" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Registrar solicitud</button>

    <a asp-action="MisSolicitudes" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}