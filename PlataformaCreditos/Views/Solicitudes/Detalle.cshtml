@model PlataformaCreditos.Models.SolicitudCredito

@{
    ViewData["Title"] = "Detalle de solicitud";
}

<h1>Detalle de solicitud</h1>

<div class="card">
    <div class="card-body">
        <p><strong>ID:</strong> @Model.Id</p>
        <p><strong>Monto solicitado:</strong> S/ @Model.MontoSolicitado</p>
        <p><strong>Fecha:</strong> @Model.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</p>
        <p><strong>Estado:</strong> @Model.Estado</p>
        <p><strong>Ingresos mensuales:</strong> S/ @Model.Cliente?.IngresosMensuales</p>

        @if (!string.IsNullOrWhiteSpace(Model.MotivoRechazo))
        {
            <p><strong>Motivo de rechazo:</strong> @Model.MotivoRechazo</p>
        }
    </div>
</div>

<a asp-controller="Solicitudes" asp-action="MisSolicitudes" class="btn btn-secondary mt-3">
    Volver
</a>